{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodikle",
  "version": "0.1.0",
  "identifier": "dev.nodikle.app",
  "build": {
    "beforeDevCommand": "npm.cmd --prefix ../../../frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm.cmd --prefix ../../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nodikle — Local-first Hybrid Workspace",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
